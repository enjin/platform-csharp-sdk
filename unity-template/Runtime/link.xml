<!--
  Preserves Enjin.Platform.Sdk types from IL2CPP code stripping.

  Newtonsoft.Json relies on reflection to (de)serialize fields, properties and
  constructors. On IL2CPP targets (mobile, console, WebGL) the linker will
  strip unreferenced members by default, breaking deserialization of the
  GraphQL response model and the QueryBuilder argument tree.

  Keeping the entire assembly is the safe default. Users who want a smaller
  build can replace this file with a more targeted ruleset.
-->
<linker>
  <assembly fullname="Enjin.Platform.Sdk" preserve="all"/>
</linker>

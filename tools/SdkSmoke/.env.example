# Endpoint of the Enjin Platform GraphQL API.
ENJIN_PLATFORM_URL=https://platform.beta.enjin.io/graphql

# Auth token for the Platform. Required.
# Generate one in the Platform UI under your account settings.
ENJIN_PLATFORM_TOKEN=

# Optional: SS58 address used by the GetAccount smoke check.
# Defaults to a known address with on-chain history if unset.
#ENJIN_PLATFORM_ACCOUNT=

# Optional: A recent block id (number) used by the GetBlock / GetBlocks
# checks. Update this from time to time as canary advances.
#ENJIN_PLATFORM_RECENT_BLOCK=
